DJANGO_SECRET_KEY=your-django-secret-key-here
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
API_LOG_LEVEL=INFO
RAG_WARMUP_ON_STARTUP=true
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
RATELIMIT_DEFAULT=30/m
AUTH_REGISTER_RATELIMIT=10/m
AUTH_LOGIN_RATELIMIT=15/m
AUTH_REFRESH_RATELIMIT=20/m
MAX_QUESTION_LENGTH=1500
DB_ENGINE=sqlite

# Milvus Configuration (Optional: defaults to local file-based milvus_local.db if empty/unset)
COGNIVIA_MILVUS_URI=your-milvus-cluster-uri
COGNIVIA_MILVUS_TOKEN=your-milvus-api-token
COLLECTION_NAME=Cognivia

# Ollama / Local Model Configuration
OLLAMA_MODEL_NAME=gemma4:latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_HEALTHCHECK_URL=http://localhost:11434
COGNIVIA_LLM_MODEL=gemma4:latest
COGNIVIA_LLM_TEMPERATURE=0.1

# Groq Configuration (Optional: If configured and online, Groq is used as primary, Ollama as fallback)
GROQ_API_KEY=your-groq-api-key
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# RAG Ingestion / Chunking Parameters
EMBEDDING_MODEL=bge-m3:latest
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
COGNIVIA_TOP_K=3
RAG_READY_TIMEOUT_MS=15000
HEALTH_CHECK_TOKEN=default-health-token-12345
