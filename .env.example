# Environment Configuration Template
# Copy this to .env and fill in your values

# Ollama Configuration
OLLAMA_MODEL_NAME=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
ACADEMERAG_LLM_MODEL=llama3.2
ACADEMERAG_LLM_TEMPERATURE=0.7

# Milvus / Zilliz Cloud Configuration (REQUIRED — no local milvus-lite)
ACADEMERAG_MILVUS_URI=https://YOUR-CLUSTER-ID.api.gcp-us-west1.zillizcloud.com
ACADEMERAG_MILVUS_TOKEN=your_zilliz_api_key_here
COLLECTION_NAME=AcademeRAG

# Vector Embedding
EMBEDDING_MODEL=mxbai-embed-large

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
ACADEMERAG_TOP_K=3

# PDF Processing
PDF_DIRECTORY=./documents
BATCH_SIZE=50

# Django Configuration
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

# API Configuration
API_BASE_URL=http://localhost:8000
API_TIMEOUT=300

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Security
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
ENABLE_HTTPS=False

# Feature Flags
ENABLE_STREAMING=True
ENABLE_CACHING=True
ENABLE_MONITORING=False
