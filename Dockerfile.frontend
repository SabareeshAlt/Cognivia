FROM node:20-alpine AS build

RUN addgroup -S appuser && adduser -S appuser -G appuser
WORKDIR /app
RUN chown -R appuser:appuser /app

USER appuser
COPY --chown=appuser:appuser Frontend/package*.json ./
RUN npm ci

COPY --chown=appuser:appuser Frontend .
RUN npm run build

FROM nginx:1.27-alpine

RUN addgroup -S appuser && adduser -S appuser -G appuser && \
    mkdir -p /app && \
    chown -R appuser:appuser /app && \
    chown -R appuser:appuser /var/cache/nginx /var/log/nginx /etc/nginx/conf.d /usr/share/nginx/html && \
    sed -i 's/80;/8080;/g' /etc/nginx/conf.d/default.conf && \
    sed -i 's/^user/#user/g' /etc/nginx/nginx.conf && \
    sed -i 's|/var/run/nginx.pid|/tmp/nginx.pid|g' /etc/nginx/nginx.conf

USER appuser

COPY --from=build --chown=appuser:appuser /app/dist /usr/share/nginx/html

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
