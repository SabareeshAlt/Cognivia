# ==============================================================================
# Cognivia - Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
Frontend/.env
Frontend/.env.*
!Frontend/.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.csr
*.keystore
secrets/

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-wheel-metadata/
pip-log.txt

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
env*/

# Testing, Linting & Type Checking caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
.tox/
.nox/
.hypothesis/
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/

# ------------------------------------------------------------------------------
# Django Framework & Static/Media Uploads
# ------------------------------------------------------------------------------
*.sqlite3
*.sqlite3-journal
db.sqlite3
local_settings.py
staticfiles/
media/

# ------------------------------------------------------------------------------
# Milvus, Vector Database, Evaluation & RAG Caches
# ------------------------------------------------------------------------------
milvus_local.db
milvus_data/
volumes/
.milvus/
*.pkl
*.npy
*.npz
prometheus_multiproc_dir/
.cache/
chroma_db/
chroma_data/
eval/eval_results/
eval_results*.json

# ------------------------------------------------------------------------------
# Node.js & Frontend (React / Vite / TypeScript)
# ------------------------------------------------------------------------------
node_modules/
Frontend/node_modules/
Frontend/dist/
Frontend/coverage/
Frontend/playwright-report/
Frontend/test-results/
Frontend/blob-report/
Frontend/.vite/
.eslintcache
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# Operating System & IDE / Editor Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini

# Editors & IDEs
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
.cursor/
.windsurf/
.zed/

# ------------------------------------------------------------------------------
# Logs & Temporary Scratches
# ------------------------------------------------------------------------------
*.log
logs/
scratch/
tmp/
temp/
.system_generated/
