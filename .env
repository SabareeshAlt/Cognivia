# ============================================
# AcademeRAG Environment Configuration
# ============================================

# --- Django Core ---
DJANGO_SECRET_KEY=d9sFFDsnX1mP81Wokr7er9T06mCkOiYkvALYHfEIYjUr84Tda-7gGaIvtQENQ63c
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
API_LOG_LEVEL=INFO
RAG_WARMUP_ON_STARTUP=true

# --- Security/CORS/CSRF ---
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0

# --- Auth / Rate Limits ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
RATELIMIT_DEFAULT=30/m
AUTH_REGISTER_RATELIMIT=10/m
AUTH_LOGIN_RATELIMIT=15/m
AUTH_REFRESH_RATELIMIT=20/m
MAX_QUESTION_LENGTH=1500

# --- Database ---
# Use sqlite or postgres
DB_ENGINE=sqlite
POSTGRES_DB=academerag
POSTGRES_USER=academerag
POSTGRES_PASSWORD=academerag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# --- Milvus / Zilliz Cloud (REQUIRED for cloud vector store) ---
ACADEMERAG_ENABLE_MILVUS_CLOUD=true
ACADEMERAG_MILVUS_URI=https://in03-200a60c94a793fc.serverless.aws-eu-central-1.cloud.zilliz.com
ACADEMERAG_MILVUS_TOKEN=4919d7d24e84b881bac067ed51e05c4749fe5af98b16a4d8249dbbff6684e5d86825b2de320d795b33d5a82e540efd86958f289c
COLLECTION_NAME=AcademeRAG
ACADEMERAG_AUTO_SYNC_INDEX=true
ACADEMERAG_MILVUS_TIMEOUT_SECONDS=15
ACADEMERAG_INGEST_BATCH_SIZE=16
ACADEMERAG_INGEST_MAX_SECONDS=1800

# --- Ollama Configuration ---
OLLAMA_MODEL_NAME=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_HEALTHCHECK_URL=http://localhost:11434
ACADEMERAG_LLM_MODEL=llama3.2
ACADEMERAG_LLM_TEMPERATURE=0.7

# --- Embedding / Retrieval ---
EMBEDDING_MODEL=mxbai-embed-large
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
ACADEMERAG_TOP_K=3
RAG_READY_TIMEOUT_MS=15000

# --- Frontend ---
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_CHAT_DISABLED=false
VITE_CANARY_PERCENT=100
VITE_API_TIMEOUT_MS=30000
VITE_MAX_JS_BUNDLE_KB=600
VITE_FEATURE_ENHANCED_STREAMING=true
VITE_FEATURE_DIAGNOSTICS_PANEL=false
